# Set terminal type
export TERM=xterm-256color

# Define app storage paths
export TERMUX_PREFIX="/data/data/com.jeremy.app/files/usr"
export HOME="/data/data/com.jeremy.app/files/home"

# Add your user bin and wasm bin directories to the system PATH
export PATH="$TERMUX_PREFIX/bin:$PATH"

# Optional: ensure standard working directories exist
mkdir -p "$HOME"
mkdir -p "$TERMUX_PREFIX/wasm"
