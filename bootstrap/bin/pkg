#!/usr/bin/env python3
import os
import sys
import json
import urllib.request

INSTALL_DIR = os.environ.get("TERMUX_PREFIX", "/data/data/com.jeremy.app/files/usr")
WASM_DIR = os.path.join(INSTALL_DIR, "wasm")
BIN_DIR = os.path.join(INSTALL_DIR, "bin")
INDEX_URL = "https://github.com/jch0029987-glitch/Custom-terminal-backend/releases/latest/download/packages.json"

def fetch_index():
    with urllib.request.urlopen(INDEX_URL) as response:
        return json.loads(response.read().decode())

def cmd_install(pkg_name):
    print(f"Fetching package index...")
    index = fetch_index()
    
    pkg_info = next((p for p in index["packages"] if p["name"] == pkg_name), None)
    if not pkg_info:
        print(f"Error: Package '{pkg_name}' not found in registry.")
        sys.exit(1)
        
    os.makedirs(WASM_DIR, exist_ok=True)
    dest_path = os.path.join(WASM_DIR, f"{pkg_name}.wasm")
    
    print(f"Downloading {pkg_name} from {pkg_info['url']}...")
    urllib.request.urlretrieve(pkg_info['url'], dest_path)
    
    # Create a convenient execution shim in usr/bin/
    shim_path = os.path.join(BIN_DIR, pkg_name)
    with open(shim_path, "w") as f:
        f.write(f'#!/bin/sh\nexec /path/to/wasi_host "{dest_path}" "$@"\n')
    os.chmod(shim_path, 0o755)
    
    print(f"Successfully installed {pkg_name}!")

if __name__ == "__main__":
    if len(sys.argv) < 3 or sys.argv[1] != "install":
        print("Usage: pkg install <package_name>")
        sys.exit(1)
    cmd_install(sys.argv[2])
